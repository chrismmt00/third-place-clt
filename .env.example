# Put shared values in .env; use ignored .env.local for local database overrides.
# Local tooling: shell environment > .env.local > .env. Never deploy .env.local.
DATABASE_URL=
TEST_DATABASE_URL=
# Keep development and integration-test databases separate.
# Confirm actual dev and production hostnames; pooled/direct Neon hosts normalize.
NONPRODUCTION_DATABASE_HOST=
PRODUCTION_DATABASE_HOST=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
CLOUDFLARE_IMAGES_ACCOUNT_ID=
CLOUDFLARE_IMAGES_TOKEN=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
# Official test keys: development only. Replace both for production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_SITE_URL=http://localhost:3000
