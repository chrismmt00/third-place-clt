# One private .env holds the production settings and owner handoff.
# Shell values override .env. This example contains no credentials.
DATABASE_URL=
# Confirm the production hostname; pooled/direct Neon hosts normalize.
PRODUCTION_DATABASE_HOST=
AUTH_SECRET=
AUTH_URL=
# Pending production owner; these values do not automatically create an account.
OWNER_NAME=Third Place Owner
OWNER_EMAIL=
OWNER_TEMPORARY_PASSWORD=
CLOUDFLARE_IMAGES_ACCOUNT_ID=
CLOUDFLARE_IMAGES_TOKEN=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
NEXT_PUBLIC_SITE_URL=

# Development only: use explicit shell overrides, never production defaults.
# DATABASE_URL=postgresql://localhost/third_place_clt_dev
# TEST_DATABASE_URL=postgresql://localhost/third_place_clt_test
# NONPRODUCTION_DATABASE_HOST=localhost
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
